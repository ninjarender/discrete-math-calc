class Demo {

  public static int resistance(int voltage, int current) {
    if (current == 0) {
      throw new ArithmeticException("Division by zero");
    }
    return voltage / current; // цілочисельне ділення
  }

  public static void main(String[] args) {
    for (String arg : args) {
      String[] pair = arg.split(",");
      int voltage = Integer.parseInt(pair[0]);
      int current = Integer.parseInt(pair[1]);

      try {
        int resistance = resistance(voltage, current);
        System.out.println(resistance);
      } catch (ArithmeticException e) {
        System.out.println("Resistance is infinite: voltage = " + voltage + ", current = " + current);
      }
    }
  }

}
