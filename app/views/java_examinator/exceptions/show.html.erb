<h2>Exercise 5</h2>
<pre><code class="java">
    import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.time.format.DateTimeParseException;
import java.time.format.ResolverStyle;

class Demo {

	public static boolean isLeap(String dateString) {
		DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/uuuu")
            .withResolverStyle(ResolverStyle.STRICT); // сувора валідація

    LocalDate date = LocalDate.parse(dateString, formatter); // може кинути виняток
    return date.isLeapYear();
	}

	public static void main(String[] args) {
		for (String arg : args) {
		  try {
  			boolean result = isLeap(arg);
  			System.out.println(result);
		  } catch (DateTimeParseException e) {
		    int errorIndex = e.getErrorIndex();

        // Захист: якщо getErrorIndex() повертає -1, знайдемо перший невалідний символ вручну
        if (errorIndex == -1) {
            errorIndex = findFirstInvalidIndex(arg);
        }

        char ch = errorIndex >= 0 && errorIndex < arg.length()
                  ? arg.charAt(errorIndex)
                  : '?';

        System.out.println(arg + ": The illegal sequence begins with the character '" + ch + "' at index " + errorIndex);
		  }
		}
	}

  private static int findFirstInvalidIndex(String s) {
    // Очікуємо формат: dd/MM/yyyy -> 10 символів: XX/XX/XXXX
    if (s.length() != 10) return 0;

    for (int i = 0; i < s.length(); i++) {
      char c = s.charAt(i);
      if (i == 2 || i == 5) {
        if (c != '/') return i;
      } else {
        if (!Character.isDigit(c)) return i;
      }
    }

    return 0; // default fallback
  }

}
